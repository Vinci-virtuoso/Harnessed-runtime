# Harnessed configuration. Copy to .env and fill in. Never commit .env.
#
# Nothing here is required to build or test the harness: the default provider is
# `fake`, which replays recorded fixtures offline. Keys are only needed for live
# runs (tickets H1 and H2).

# ---- Which provider the loop uses -------------------------------------------
# One of: fake | groq | deepseek | openrouter | openai | ollama | anthropic
HARNESSED_PROVIDER=fake
# Override the default model id for that provider. Just a string.
# HARNESSED_MODEL=llama-3.3-70b-versatile
# The cheap model used by the retrieval gate, the reflector and consolidation.
# HARNESSED_SMALL_MODEL=

# ---- Provider keys (set only the one you use) -------------------------------
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Custom endpoint (any OpenAI-compatible server: vLLM, Ollama, LM Studio) --
# HARNESSED_BASE_URL=http://localhost:11434/v1

# ---- Embeddings --------------------------------------------------------------
# Semantic memory works with zero setup via SQLite FTS5. Vectors are optional.
# Install the [embed] extra for local ONNX embeddings, or point at any
# OpenAI-compatible /v1/embeddings endpoint here.
# HARNESSED_EMBED_BASE_URL=
# HARNESSED_EMBED_MODEL=

# ---- Router ------------------------------------------------------------------
# The model the router's Decisions calls are pinned to. Default: typesafe/jev-1.13-20260917
# HARNESSED_ROUTER_MODEL=

# ---- Loop and retrieval ceilings ---------------------------------------------
# How many tokens of retrieved memory ride on a request. Default: 4000
# HARNESSED_TOKEN_BUDGET=
# How many passes one run may take before it stops. Default: 12
# HARNESSED_MAX_ITERATIONS=
# How many seconds an agent's permission request waits for you before it is denied. Default: 600
# HARNESSED_PERMISSION_CEILING_S=
# How many unconsolidated episodes make one consolidation batch. Default: 20
# HARNESSED_CONSOLIDATE_AFTER=

# ---- Paths -------------------------------------------------------------------
# Where the SQLite db, transcripts and ACP logs live. Default: ./.harnessed
# HARNESSED_HOME=

# ---- Evals -------------------------------------------------------------------
# HARNESSED_RUN_LIVE_EVALS = "1"
# DEEPEVAL_TELEMETRY_OPT_OUT = "YES"

# ---- Dashboard ---------------------------------------------------------------
# Read by the Next.js dashboard only (dashboard/lib/gateway-origin.ts), not by the
# Python package. Where `harnessed serve` answers. Default: http://127.0.0.1:8756/v1
# HARNESSED_GATEWAY_URL=http://127.0.0.1:8756/v1
