{
  "name": "harnessed-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Harnessed dashboard: a read-only view of the gateway (FR-43).",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "next build",
    "export": "node scripts/stage-export.mjs",
    "start": "next start -H 127.0.0.1 -p 8757",
    "e2e": "playwright test",
    "capture": "playwright test --config tests/capture/playwright.config.ts"
  },
  "dependencies": {
    "geist": "1.7.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "vitest": "5.0.0"
  }
}
